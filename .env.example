# Frontend build-time environment variable (set in GitHub Actions Repository Variables)
# Example: https://puno-multiplayer-server.onrender.com
VITE_BACKEND_URL=""

# Optional explicit Socket.IO server URL override (defaults to VITE_BACKEND_URL)
VITE_SOCKET_URL=""

# Optional Vite base path override (defaults to /PUNO/ for production builds)
VITE_BASE_PATH="/PUNO/"

# Backend CORS & URL configuration (set on Render)
PORT="3001"
CORS_ORIGINS="https://j4sirh0ssain-sys.github.io"
FRONTEND_URL="https://j4sirh0ssain-sys.github.io/PUNO/"

# AI Studio runtime host URL (injected automatically in AI Studio)
APP_URL=""
